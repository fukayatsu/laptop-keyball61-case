// ============================================================
// Keyball61 ラップボード(膝上ケース) 共通パラメータ
// 座標系: X+ = 右(東), Y+ = 奥(北), Z+ = 上
// 各パーツはそれぞれのローカル原点(南西角)でモデリングする
// ============================================================

clr = 0.35;           // はめあいクリアランス(片側)

// ---------- キャリッジ(可動台座・楔形) ----------
tent_angle   = 7;     // 固定テンティング角(内側が高くなる)
car_w        = 170;   // 幅(左キャリッジ: x=0が外側=低い側)
car_d        = 200;   // 奥行き
car_base_t   = 6;     // 最低肉厚(外側端 x=0 での板厚)
car_corner_r = 8;     // フットプリント角R

// キーボードポケット(プレート実寸は keyball61_outline.scad)
pocket_x0           = 30;    // ポケット西端X
pocket_north_margin = 8;     // ポケット北端からキャリッジ北端までの余白
pocket_depth        = 2.6;   // ポケット深さ(垂直測り)

// ノブネジ列(外側の低い帯に配置)
knob_x     = 15;             // ノブ列X
pivot_y    = 160;            // 回転ピボットY
lock_y_min = 28;             // ロックスロットY範囲
lock_y_max = 62;
knob_hole_d = 4.6;           // M4クリアランス
seat_floor  = 6.6;           // ノブ座面(スポットフェース)の高さ
seat_d      = 26;            // 座面径

ball_hole_d = 14;            // ボール取出し穴(キャリッジ側)

// M2 キーボード固定(オプション)
m2_hole_d  = 2.4;
m2_cb_d    = 5.8;            // 下からの座ぐり径
m2_remain  = 3.4;            // ポケット床下に残す肉厚

// 北側フック(キーボード押さえ爪)
hook_plate_x  = [15, 55];    // プレート座標系でのフック中心X(北端が直線の区間)
hook_w        = 14;
hook_overhang = 3;           // ポケット側への張り出し
hook_h        = 3.5;
hook_anchor   = 6;           // 壁側への食い込み長
hook_gap      = 2.3;         // ポケット床からフック下面までの垂直距離(プレート2mm+0.3)

// ---------- ベース(3分割) ----------
base_t        = 8;    // M3x8皿(継手)がツライチ / M4x12-15ノブ(ワッシャ付)が収まる厚み
base_d        = 215;
base_side_w   = 195;         // 左右ピース幅
base_center_w = 95;          // 中央ピース幅(全幅 = 195*2+95 = 485)
base_corner_r = 10;

// 継手(中央ピース下段が左右ピース下面の欠きに入る)
joint_tab_l   = 15;          // 下段ひさしの突出長
joint_step_t  = 3.6;         // 下段厚
joint_screw_y = [40, 107.5, 175];

// Tスロット溝(M4四角ナット: 対辺7 x 厚2.4 を想定)
ch_slot_w     = 4.6;         // 上面開口幅
ch_top_t      = 2.2;         // 開口上壁厚(ナットが引き付く面)
ch_cav_w      = 7.6;         // ナット空洞幅
ch_cav_h      = 3.4;         // ナット空洞高
ch_bot_slot_w = 5.2;         // 底抜きスロット幅(長いネジの逃げ)
ch_rear_y     = 167;         // 後溝Y(ピボット用) ※キャリッジ配置と連動
ch_front_y    = 52;          // 前溝Y(ロック用)
ch_x0         = -1;          // 溝X範囲(西端開放=ナット挿入口)
ch_x1         = 160;

// 組立プレビューでのキャリッジ内側端の中心からの距離
car_inner_gap = 35;

// ---------- Touch ID ポッド ----------
// 実測値(2026-08-14): 基板 85x31x3 / ボタン 16x16x3 / ポート 19x3.1
// 薄型バッテリー 123x30x3 (有りの場合は基板の下に縦積み)
// 基板は長辺を前後(Y)方向に収める
tid_battery = false; // バッテリー版は -D tid_battery=true で生成 (make で両STL生成)
tid_bat_l  = 123;   // バッテリー長辺
tid_bat_t  = 3;     // バッテリー厚
tid_bay_w  = 34;    // ベイ幅   (基板短辺31 + 余裕)
tid_bay_d  = tid_battery ? tid_bat_l + 3 : 88;  // ベイ奥行
tid_bay_h  = tid_battery ? 7 : 4;               // ベイ深さ (電池3+基板3+余裕 / 基板3+余裕)
tid_btn_w  = 16;    // センサーボタン一辺(正方形) → 蓋の角穴 = +2*clr
tid_btn_x  = 0;     // ベイ中心からのボタン中心オフセットX
tid_btn_y  = -28;   // 同Y(手前が負)。※ボタン実位置に合わせて調整
tid_port_w = 20;    // 充電ポート開口幅(北面) 実測19 / 0で無効
tid_port_h = 4.5;   // 同高さ 実測3.1+プラグ余裕
tid_port_off = 0;   // ポート中心の左右オフセット(※あとで調整)
tid_pedestal_h = 0; // ボタン下の台座高さ(0=無効。ボタンが沈む場合に使う)
tid_wall   = 3;
tid_lid_t  = 2;

pod_screw_span = 48;  // フランジ穴スパン(ベース中央ピースの穴と一致させる)
pod_y          = 145; // ベース側の取付穴Y(両バージョン共通・固定)
// バッテリー版はベイが北へ伸びるため、フランジ穴をポッド中心からずらして
// ベース側の穴位置を共通にする(ポッド中心 = pod_y - pod_flange_off)
pod_flange_off = tid_battery ? 19 : 0;

// M3 (ベース継手・ポッド固定)
m3_hole_d  = 3.4;
m3_cs_d    = 6.8;    // 皿ざぐり径
m3_nut_af  = 5.8;    // 六角ナットポケット対辺(M3ナット5.5+0.3)
m3_nut_t   = 2.9;    // 同深さ

$fn = 48;
