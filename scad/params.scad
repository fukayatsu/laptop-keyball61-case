// ============================================================
// Keyball61 ラップボード(膝上ケース・固定式) 共通パラメータ
// 座標系: X+ = 右(東), Y+ = 奥(北), Z+ = 上
// 組立座標系(グローバル): 中心 x=0, 手前が y小
// ============================================================

clr = 0.35;           // はめあいクリアランス(片側)

// ---------- 全体レイアウト(固定) ----------
splay        = 10;    // ハの字角(固定)。変更したら全パーツ再印刷
tent_angle   = 7;     // テンティング角(内側が高い)
kb_corner_x  = 45;    // キーボードブロック後内側コーナーの中心からの距離(=後方ギャップの半分)
kb_corner_y  = 238;   // 同コーナーのY

// ---------- サイドピース(キーボードブロック+パームレスト) ----------
kb_wall      = 6;     // ポケット周囲の壁厚
wedge_t0     = 6;     // 楔の最低肉厚(外側端)
palm_w       = 144;   // パームレスト幅(kbブロック幅146.9未満にして内側エッジを直線に保つ)
palm_d       = 88;    // 同奥行き
palm_overlap = 3;     // キーボードブロックへの食い込み
palm_r       = 18;    // 角R
// ケースはアクリル底板の置き換え: ポケット床=取付面。キーボードは
// 純正M2ネジで下から直接固定する(フック等は無し)
pocket_depth = 2.6;   // 取付面の彫り込み深さ(=周囲の縁の高さ)

ball_hole_d  = 12;    // ボール取出し穴(アクリルは11.3)

// M2 キーボード固定穴(スペーサーへ下からネジ止め・必須)
m2_hole_d  = 2.4;
m2_cb_d    = 6.2;     // 下からの座ぐり径(ドライバー通し)
m2_remain  = 2.0;     // 取付面下に残す肉厚 = アクリル板厚。純正ネジがそのまま使える

// トラックボールケース固定穴(下から白ケースへセルフタップ・純正ネジ)
bc_hole_d  = 2.8;     // 貫通穴(アクリルは2.36)
bc_cb_d    = 7.0;     // 下からの座ぐり径
// 残り肉厚は m2_remain と共通(2.0)

// ボールPCB切り欠き部の逃げ(取付面からさらに掘り下げる深さ)
notch_relief = 4;

// ---------- 中央ブリッジ ----------
bridge_t     = 8;     // ブリッジ板厚
bridge_y0    = 88;    // 南端(ここより手前の中央は開放空間)
bridge_y1    = 250;   // 北端
seam_clr     = 0.5;   // サイドとの隙間
ledge_w      = 25;    // 継手タブ幅(サイド下面のポケットに入る)
ledge_t      = 3.6;   // タブ厚
tab_len      = 26;    // タブの継ぎ目方向長さ(サイド側ポケット天井のブリッジ距離。
                      //  ポケットは前後の壁で両端支持されるのでサポート不要)
joint_screw_ys = [110, 165, 220];  // 継手ネジのY(斜め継ぎ目沿い・片側3本)
joint_screw_inset = 10;            // 楔エッジからネジ中心までの距離
joint_y0 = 95;                     // 連続タブのY範囲
joint_y1 = 235;
// リブ入り連続継手: サイドの連続タブ(凸)の切り欠きに、ブリッジ側ポケット(凹)内の
// リブが噛み合う。リブがポケット天井の中間支柱になり、ブリッジは
// 両端支持の約28mmブリッジ×5区間でサポート不要のまま連続かみ合いにできる
joint_rib_ys = [122.7, 150.9, 179.1, 207.3];  // リブ中心Y(ネジ位置を回避)
joint_rib_w  = 3;                  // リブ幅(サイド側切り欠きは +2*clr)

// ---------- ブレースプレート(上側の左右連結・箱構造化) ----------
// ポッドの上を跨いで左右サイドの内壁上面に渡し、M3x8皿セルフタップ x2/側で固定。
// OLED/ProMicro部(奥側)を避けた範囲に架ける
brace_t       = 3.5;   // プレート厚
brace_y0      = 100;   // 南端
brace_y1      = 162;   // 北端(これより奥は TRSジャック/L字プラグ・OLED と干渉するため避ける)
brace_shelf_z = 22.2;  // サイド側座面の高さ(バッテリー版ポッド上面21.4+0.8クリア)
brace_shelf_w = 10;    // 座面幅(継ぎ目から内側へ)
brace_overlap = 8;     // プレートが座面に乗る幅
brace_screw_ys = [108, 154];  // 固定ネジY(片側2本)
brace_screw_inset = 5;        // 継ぎ目からネジ中心までの距離

// M3 (継手・ポッド固定)
m3_hole_d  = 3.4;
m3_cs_d    = 6.8;     // 皿ざぐり径
m3_nut_af  = 5.8;     // 六角ナットポケット対辺(M3ナット5.5+0.3)
m3_nut_t   = 2.9;     // 同深さ

// ---------- Touch ID ポッド ----------
// 実測値(2026-08-14): 基板 85x31x3 / ボタン 16x16x3 / ポート 19x3.1
// 薄型バッテリー 123x30x3 (有りの場合は基板の下に縦積み)
tid_battery = false; // バッテリー版は -D tid_battery=true で生成 (make で両STL生成)
tid_bat_l  = 123;
tid_bat_t  = 3;
tid_bay_w  = 34;    // ベイ幅   (基板短辺31 + 余裕)
tid_bay_d  = tid_battery ? tid_bat_l + 3 : 88;  // ベイ奥行
tid_bay_h  = tid_battery ? 7 : 4;               // 電池3+基板3+余裕 / 基板3+余裕
tid_btn_in_lid = false; // ボタンはケーブル延長してキーボード側に配置予定のため蓋穴なし
                        // (蓋にボタンを出す場合は true に)
tid_btn_w  = 16;    // センサーボタン一辺(正方形) → 蓋の角穴 = +2*clr
tid_btn_x  = 0;     // ベイ中心からのボタン中心オフセットX
tid_btn_y  = -28;   // 同Y(手前が負)。※ボタン実位置に合わせて調整
tid_port_w = 20;    // 充電ポート開口幅(南面) 実測19 / 0で無効
tid_port_h = 4.5;
tid_port_off = 0;   // ポート左右オフセット(※あとで調整)
tid_pedestal_h = 0; // ボタン下の台座高さ(0=無効)
tid_wall   = 3;
tid_lid_t  = 2.4;

// TRSケーブルギャラリー(ポッド北側の蓋付き配線溝)
gal_ch     = 8;     // チャンネル幅(前後)
gal_wall   = 3;     // 北外壁厚
gal_floor  = 3;     // 溝底の厚み

pod_screw_span = 48;  // フランジ穴スパン(ブリッジの穴と一致)
pod_y          = 178; // ブリッジ側の取付穴Y(両バージョン共通・固定)
// バッテリー版はベイが南へ伸びるぶんフランジ穴をオフセットし、
// 取付穴とポッド北端(ギャラリー位置)を両バージョンで揃える
pod_flange_off = tid_battery ? 19 : 0;

$fn = 48;
