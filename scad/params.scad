// ============================================================
// Keyball61 ラップボード 共通パラメータ (v4で使用する項目のみ)
// 座標系: X+ = 右(東), Y+ = 奥(北), Z+ = 上
// 組立座標系(グローバル): 中心 x=0, 手前が y小
// 旧v2(固定式楔)・v3(中空モジュール)のパラメータはgit履歴を参照
// ============================================================

clr = 0.35;           // はめあいクリアランス(片側)

// ---------- 全体レイアウト ----------
splay        = 10;    // ハの字角(固定)。変更したら全パーツ再印刷
tent_angle   = 7;     // テンティング角(内側が高い)
kb_corner_x  = 45;    // キーボードブロック後内側コーナーの中心からの距離
                      // (v4は v4_corner_x = kb_corner_x - 25 を使用)
kb_corner_y  = 238;   // 同コーナーのY

// ---------- キーボード搭載部 ----------
kb_wall      = 6;     // アクリル外形の周囲マージン(外形の配置オフセット)
wedge_t0     = 6;     // 楔面の基準肉厚(lib.scadの傾斜面定義で使用)
plate_t      = 2;     // 取付プレート厚(=アクリル板厚。純正ネジ長がそのまま使える)
pocket_depth = 4.6;   // lib.scadの座面高さ定義で使用

// ---------- パームレスト ----------
palm_w       = 108;   // パームレスト幅
palm_x0      = 2.5;   // パームの外側エッジ位置(kbフレームx)
palm_d       = 88;    // 同奥行き
palm_overlap = 3;     // キーボードブロックへの食い込み
palm_r       = 18;    // 角R

// ---------- 穴径 ----------
ball_hole_d  = 12;    // ボール取出し穴(アクリルは11.3)
m2_hole_d  = 2.4;     // M2クリアランス(プレート側)
bc_hole_d  = 2.8;     // ボールケースネジ(プレート側, アクリルは2.36)

// M3 (ジョイント・カバー固定)
m3_hole_d  = 3.4;
m3_cs_d    = 6.8;     // 皿ざぐり径
m3_nut_af  = 5.8;     // 六角ナットポケット対辺(M3ナット5.5+0.3)
m3_nut_t   = 2.9;     // 同深さ

$fn = 48;
