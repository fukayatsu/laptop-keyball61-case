// v4: 極力2mm厚の平面構造(前作ラップボード方式)
//  - 左右サイド = キーボード搭載部+パームレスト一体の2mm平板(完全平面・ベタ置き印刷)
//  - 中央 = 切妻テント形の中実スパイン板(上面=左右7°の切妻, 底面=フラットで浮く)。
//    テント角はスパインの形状で作る。組立の向きのままベタ置き印刷(サポートゼロ)
//  - Touch IDモジュール等の収納は一旦なし(箱をやめてシンプル化)
// ベース寸法・外形は ../params.scad / ../keyball61_outline.scad を共用
include <../lib.scad>

v4_pt     = 2;      // プレート厚
v4_fit    = 0.15;   // プレート下面とスパイン上面のクリアランス
v4_spine_z0 = 13.5; // スパイン底面の高さ(フラット。接地せず浮く)
v4_rim_t  = 2.5;    // キーボードフェンス厚
v4_rim_h  = 6;      // 同高さ(プレート上面から)

// 左右間隔(v3と同じ短縮値)
v4_corner_x = kb_corner_x - 25;
function v4_seam(y) = v4_corner_x + (kb_corner_y - y) * tan(splay);

// プレートの中央側の張り出し(屋根フランジへの重なり幅, kbローカルx)
v4_ovl = 12;

// 中央ジョイント: スパイン上の縦M3x8なべ x3/側。
// ネジ軸は kbローカル (kbw + 6, jyl(jy))。ナットは底面の六角ポケット(軸方向)
v4_cj_ys = [120, 170, 220];
function v4_jyl(jy_g) = kbd - (kb_corner_y - jy_g) / cos(splay);

// 中央箱
v4_y0 = 88;
v4_y1 = 250;
v4_r  = 6;          // 平面視の角丸
// 結束バンドスロット対(露出したスパイン上面を貫通。ケーブル等の固定用)
v4_tie_pairs = [[-12, 150], [12, 150], [-8, 205], [8, 205]];

// 下箱(v4_center_case)の取付ネジ位置: スパイン底面=箱の蓋。
// ジョイントの六角ポケット(|x|=seam-5.9付近)・結束バンドスロットを避けること
v4_case_screws = [[-10, 120], [10, 120], [-10, 218], [10, 218]];

// ボール張り出し帯の貫通欠き取り(v2実機知見の保守的な移植)。
// ユーザー実物確認(2026-08-18)で「埋めてよい」→既定は無効。
// もし組立時にボール周辺部品がプレートに当たる場合は true に戻す
v4_ball_relief = false;
