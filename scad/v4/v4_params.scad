// v4: 極力2mm厚の平面構造(前作ラップボード方式)
//  - 左右サイド = キーボード搭載部+パームレスト一体の2mm平板(完全平面・ベタ置き印刷)
//  - 中央 = 切妻テント形の中実スパイン板(上面=左右7°の切妻, 底面=フラットで浮く)。
//    テント角はスパインの形状で作る。組立の向きのままベタ置き印刷(サポートゼロ)
//  - Touch IDモジュール等の収納は一旦なし(箱をやめてシンプル化)
// ベース寸法・外形は ../params.scad / ../keyball61_outline.scad を共用
include <../lib.scad>

v4_pt     = 2;      // プレート厚
v4_fit    = 0.15;   // プレート下面とスパイン上面のクリアランス
v4_spine_z0 = 13.5; // スパイン底面の高さ(フラット。接地せず浮く)
// 左右間隔(v3と同じ短縮値)
v4_corner_x = kb_corner_x - 25;
function v4_seam(y) = v4_corner_x + (kb_corner_y - y) * tan(splay);

// プレートの中央側の張り出し(屋根フランジへの重なり幅, kbローカルx)
v4_ovl = 12;

// 中央ジョイント: スパイン上の縦M3x8なべ x3/側。
// ネジ軸は kbローカル (kbw + 6, jyl(jy))。ナットは底面の六角ポケット(軸方向)
v4_cj_ys = [120, 170, 220];
function v4_jyl(jy_g) = kbd - (kb_corner_y - jy_g) / cos(splay);

// 中央スパイン/カバーのy範囲: プレートが覆う範囲に収める(飛び出し防止。
// プレートのkb南縁は内側コーナーで y≈114.4、後端コーナーは y=238)
v4_y0 = 114;
v4_y1 = 238;
v4_r  = 6;          // 平面視の角丸
// カバー(v4_center_cover)の取付ネジ位置: スパイン底面=カバーの蓋。
// セルフタップ廃止: スパイン上面(プレートに覆われない露出帯)の六角井戸に
// ナットを上から落とし込み、下からM3x8なべで締める(全ネジがボルト+ナットに)。
// 位置は露出帯(|x| < seam-11.8)内かつジョイント六角ポケット(|x|=seam-5.9±3.3)を回避
v4_case_screws = [[-24, 120], [24, 120], [-10, 218], [10, 218]];
v4_case_nut_z = 15.2;   // ナット井戸の床(底面+1.7)。ネジ先端の名目18.45に対し
                        // ナット上面16.9..17.6で掛かり代+0.85mmの余裕
                        // (16.0だと余裕0.05mmしかなく、印刷誤差でM3x8皿が届かなかった=実機知見)

// たわみ抑えリブ(プレート上面, キーボードとジェルパッドの間に水平一直線。
// 実機使用でパーム側のたわみが気になるとのユーザー指摘(2026-08-18)による)
// ジェルパッド80x95mmのスペースをパーム外側の隅に確保:
// パッド領域 = sx 2.5..97.5 (95幅) x sy -85..-5 (80奥行)。水平リブはその北縁に沿う。
// 縦リブは外側エッジ沿い(角のケーブルスロットsy119..122とパッド領域を避ける)。
// 2本は西端で合流してL字になる
// 端点は丸端がクリップにかからない位置に(斜め切れ・はみ出し防止)。
// 2本の始点を同一点にして面一で合流させる
v4_ribs = [
    [[4, -2.5], [161, -2.5]],   // 水平(キーボード〜パッド間)
    [[4, -2.5], [4, 116.5]],    // 縦(外側エッジ沿い)
    // スパイン接続帯(外形東縁139.8〜内縁168の蝶番部)の横リブ:
    // 曲げ軸(南北)に直交する東西スタブでたわみを抑える(実機知見)。
    // ボルト(jyl=5.7/56.5/107.25)とTRS穴(sy56..89)の隙間に配置
    [[143.3, 31], [164.9, 31]],
    [[143.3, 98], [164.9, 98]],
];
v4_rib_w  = 3;
v4_rib_h  = 5;            // プレート上面からの高さ(キーボード下面より低いこと)

// ボール張り出し帯の貫通欠き取り(v2実機知見の保守的な移植)。
// ユーザー実物確認(2026-08-18)で「埋めてよい」→既定は無効。
// もし組立時にボール周辺部品がプレートに当たる場合は true に戻す
v4_ball_relief = false;
