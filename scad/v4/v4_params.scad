// v4: 極力2mm厚の平面構造(前作ラップボード方式)
//  - 左右サイド = キーボード搭載部+パームレスト一体の2mm平板(完全平面・ベタ置き印刷)
//  - 中央 = 切妻テント形の中実スパイン板(上面=左右7°の切妻, 底面=フラットで浮く)。
//    テント角はスパインの形状で作る。組立の向きのままベタ置き印刷(サポートゼロ)
//  - キーボードは別体のボトムプレート(v4_bottom_plate, アクリル相当)に固定し、
//    それを左右プレートの上に重ねてM3でネジ止め(2026-10-14)
//  - Touch ID基板とTRSケーブルは中央上面の上部カバー(v4_top_cover)に収める
// ベース寸法・外形は ../params.scad / ../keyball61_outline.scad を共用
include <../lib.scad>

v4_pt     = 2;      // プレート厚
v4_fit    = 0.15;   // プレート下面とスパイン上面のクリアランス
v4_spine_z0 = 10.5; // スパイン底面の高さ(フラット。接地せず浮く)。上部カバーの長ネジの
                    // ナットポケットが入る厚み(柱位置で約7.3mm)を確保する高さ
// 左右間隔(v3の20から更に左右で2cm短縮・ユーザー指定 2026-10-14)。
// 奥端(y>228)ではプレートの張り出しが中心線を越えるため、プレートは
// 中心線から v4_mid_clr 手前でカット(左右のプレートが稜線で突き合わせになる)
v4_corner_x = kb_corner_x - 35;
function v4_seam(y) = v4_corner_x + (kb_corner_y - y) * tan(splay);

// プレートの中央側の張り出し(屋根フランジへの重なり幅, kbローカルx)
v4_ovl = 12;
v4_mid_clr = 0.25;  // 中心線とのクリアランス(片側, プレート下面で)

// 中央ジョイント: スパイン上の縦M3x8なべ。ネジ軸は kbローカル (kbw + 6, jyl(jy))。
// ナットは底面の六角ポケット(軸方向)。上部カバーの範囲(sy>=29.5)は
// カバーの長ネジがスパインまで締めるので、カバーより南の1本/側だけ残す(2026-10-15)
v4_cj_ys = [120];
v4_sp_meat = 3;     // スパインのナットポケット天井の肉(スパイン上面から)
// スパインの外縁(プレート座標sx)。KB外形sx140〜縫い目の帯(蝶番部)も下から支え、
// 上部カバーの柱(sx149.5)の長ネジをスパインまで通す。上部カバー西壁と揃える
v4_spine_x0 = 141;
function v4_jyl(jy_g) = kbd - (kb_corner_y - jy_g) / cos(splay);

// 中央スパイン/カバーのy範囲: プレートが覆う範囲に収める(飛び出し防止。
// プレートのkb南縁は内側コーナーで y≈114.4、後端コーナーは y=238)
v4_y0 = 114;
v4_y1 = 238;
v4_r  = 6;          // 平面視の角丸
// たわみ抑えリブ(プレート上面, キーボードとジェルパッドの間に水平一直線。
// 実機使用でパーム側のたわみが気になるとのユーザー指摘(2026-08-18)による)
// ジェルパッド80x95mmのスペースをパーム外側の隅に確保:
// パッド領域 = sx 2.5..97.5 (95幅) x sy -85..-5 (80奥行)。水平リブはその北縁に沿う。
// 縦リブは外側エッジ沿い(角のケーブルスロットsy119..122とパッド領域を避ける)。
// 2本は西端で合流してL字になる。
// (スパイン接続帯の横リブsy31/98は上部カバーが帯を跨いで締結するため廃止)
// 端点は丸端がクリップにかからない位置に(斜め切れ・はみ出し防止)。
// 2本の始点を同一点にして面一で合流させる
v4_ribs = [
    [[4, -2.5], [161, -2.5]],   // 水平(キーボード〜パッド間)
    [[4, -2.5], [4, 120.5]],    // 縦(外側エッジ沿い。北端はベルトループの西脚に合流)
];
v4_rib_w  = 3;
v4_rib_h  = 5;            // プレート上面からの高さ(キーボード下面より低いこと)


// プレート座標(sx=斜面沿い実寸, sy, z=プレート下面から法線方向) -> グローバル(左)
module v4_place_plate_left() {
    v4_place_left() rotate([0, -tent_angle, 0]) children();
}
module v4_place_left() {
    translate([-v4_corner_x, kb_corner_y, 0]) rotate([0, 0, -splay])
        translate([-kbw, -kbd, 0]) children();
}
// 同じく平面視(2D)。sx -> kbローカルx = sx*cos(tent)
module v4_place_plate_left2d() {
    translate([-v4_corner_x, kb_corner_y]) rotate(-splay)
        translate([-kbw, -kbd]) scale([cos(tent_angle), 1]) children();
}

// ---------- ボトムプレート(キーボード直付け・アクリル相当) ----------
// 2mm平板(純正M2ネジ長がそのまま使える)。左右プレートの上に重ね、
// KB外形の外に出した耳でM3x8なべ(左右プレートの下から)→耳の上開き六角井戸のナット。
// ネジ頭は左右プレート下面に2.4mm出るので、接地ライン(外側エッジ)から離した位置だけに置く。
// 耳の位置(プレート座標sx, sy)の制約:
//  - 南帯のsx40..105はボールケースがKB外形の外へ張り出す(実機知見)ので避ける
//  - 内側(東)の耳はスパイン(sx>=141)の上。頭はスパイン上面の逃げ穴に入る
//  - 上部カバーの柱・TRSプラグの切欠き(sy57.7..71.7)と重ねない
v4_bp_t     = 2;      // ボトムプレート厚(=アクリル厚)
v4_bp_ears  = [[40, 113], [110, 119.5], [34, 8.5], [118, 8.5], [146, 47], [146, 100]];
v4_bp_ear_d = 9;      // 耳ボス径
v4_bp_boss_h = 6.2;   // 耳ボス上面(ボトムプレート下面から)。床2+井戸4.2
                      // ネジ先端=下面から6.0(M3x8 - 左右プレート2)で面一手前
v4_m2_head_clr = 5.5; // 左右プレート側: キーボードM2ネジ頭の逃げ穴
v4_bc_head_clr = 6;   // 同: ボールケースネジ頭の逃げ穴

// ---------- 上部カバー(Touch ID基板 + TRSケーブル) ----------
// キーボードの間・スパインの真上に載る、底の開いた箱。天面は水平(伏せて印刷)。
// 外形はプレート座標で sx >= v4tc_x0, v4tc_y0 <= sy <= v4tc_y1 の範囲(左右対称)。
// 左右プレートのKB外形〜縫い目の帯(sx140..156, 蝶番部)に柱を立て、
// 柱は天板まで通し、天板の座ぐりからM3x25なべ→左右プレート→スパイン底面のナットで共締め。
// 左右を橋渡しして中央の剛性も上げる
v4tc_x0 = 141;        // 西壁の外面(KB外形東縁sx140から1mm)
v4tc_y0 = 29.5;       // 南壁の外面(ボトムプレートの指状部sy<=28を避ける)
v4tc_y1 = 124;        // 北壁の外面(プレート北縁125.5)
v4tc_nw = [150, 112]; // 北西角の面取り(KBのUSBプラグ逃げ): (v4tc_x0, nw.y)-(nw.x, v4tc_y1)
v4tc_t  = 2;          // 壁・天面の厚さ
v4tc_r  = 2;          // 平面視の角丸
v4tc_cols = [[149.5, 35], [149.5, 80], [149.5, 113]];   // 柱=取付ネジ位置(北は面取りを避ける)
v4tc_col_d = 9;
// TRSプラグ: L型。ジャック(プレート座標sx138, sy64.7)から東へ挿さる。
// ジャック軸の高さは実機で要確認(ボトムプレート上面からの値)
v4tc_jack_y = 64.7;
v4tc_jack_h = 11;     // プラグ軸の高さ(ボトムプレート上面から, 要実測)
v4tc_plug_d = 11;     // プラグ頭の太さ
v4tc_notch_w = 14;    // 西壁のプラグ切欠き幅
v4tc_notch_top = v4_pt + v4_bp_t + v4tc_jack_h + v4tc_plug_d / 2 + 1.5;  // プレート座標z
// 天面の高さ(グローバル): 西壁内面で切欠き上端+1mmの上に天板
v4tc_top_z = (v4tc_x0 + v4tc_t) * sin(tent_angle) + v4tc_notch_top * cos(tent_angle)
             + 1 + v4tc_t;
// Touch ID基板 85x31x3: 天板の裏に両面テープで貼る(位置決め枠付き)。南北向き・ポートは北
v4tc_tid = [31, 85, 3];
v4tc_tid_y0 = 146;    // 基板の南端(グローバルy)
v4tc_port_w = 14;     // 北壁のUSB-C窓(幅)。天板の縁ごと切り欠く(プラグが天板裏より上に出るため)
v4tc_port_h = 6;      // 同: 天板裏から下への矩形部。その下は45°の尖り(伏せ印刷でブリッジなし)
