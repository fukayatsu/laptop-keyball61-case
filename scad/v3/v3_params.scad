// v3 モジュラー構造(中空箱+縦壁フランジ結合)の追加パラメータ
// ベース寸法・外形・レイアウトは ../params.scad / ../keyball61_outline.scad を共用
include <../lib.scad>

v3_wall     = 2.5;   // 箱の壁厚
v3_top      = 3;     // 天板厚(プレート座の下)
v3_joint_clr = 0.2;  // 箱同士の合わせ面クリアランス
// ジョイントは全て「垂直M3x8なべ + 横挿しナットスロット」方式。
// 上からドライバーで締結でき、ナットはスロットに事前挿入して回り止め。
// スロット天井2.5mmが締結面。ナットの対角(6.35)が軸の真下まで届く奥行きを取る
v3_slot_w = 5.9;   // ナットスロット幅(M3対辺5.5+0.4)
v3_slot_t = 2.7;   // 同厚(ナット2.4+0.3)

// KB箱⇔中央箱: KB東壁の切り欠き+受けボス帯へ中央箱の長耳(穴3)から縦M3
v3_cj_ys  = [120, 170, 220];

// KB箱⇔パーム箱: KB南壁の切り欠き+受けボス帯へパームの長耳(穴3)から縦M3
// 注意: ボール部品の張り出し帯(kb x>=46, 実機確認)を避けて x<=45 に収めること。
// また楔の低い側では ネジ穴スタック(耳2.5+天井2.5+スロット2.7) が収まるよう x>=21
v3_pj_xs   = [22, 32, 41];
v3_pj_tab_t = 2.5;           // パーム耳の厚さ(楔面と面一, 下面=楔面-2.5)

// 左右キーボードの間隔をv2より5cm縮める(継ぎ目を各側25mm内側へ)
v3_corner_x = kb_corner_x - 25;
function v3_seam(y) = v3_corner_x + (kb_corner_y - y) * tan(splay);

// KBフレーム内部の井桁壁(垂直x2+水平y2, kbローカル)。
// 全プレート穴(M2/BC/ボール)から壁面まで7mm以上離すこと(ネジ頭・スペーサー逃げ)
v3_grid_x = [44, 113];
v3_grid_y = [45, 74];
v3_seat_w = 4;               // 周壁内側のプレート座リブ幅(座面=楔面-4.6)
// プレート固定ネジ(井の交点=Φ8ボス, kbローカル座標)
v3_plate_screws = [[44, 45], [44, 74], [113, 45], [113, 74]];

// パーム箱(kbフレーム, KB箱の南に接続)
v3_palm_w  = 108;
v3_palm_x0 = 2.5;
v3_palm_d  = 88;

// 中央箱(間隔短縮で幅が細い台形。北端の半幅は約18mm)
v3_cbox_h  = 16;    // 高さ(トーションボックス。ブリッジ+ブレースの代替)
v3_cbox_y0 = 88;
v3_cbox_y1 = 250;
v3_cbox_r  = 6;     // 四隅の角丸半径
// 底蓋(あと付け可): 内周に収まる台形板をボス柱4本にM3x8皿で固定(頭は底面ツライチ)
v3_lid_t = 2.5;
v3_lid_bosses = [[-28, 95], [28, 95], [-12, 230], [12, 230]];  // 台形幅に収める
// 結束バンド用スロット対 [中心x, 中心y]: 3x14の縦穴2個(±4.75mm)を1組として天板に開ける
// バッテリー(123x30x3)はポッドではなく箱内部にこのスロットで固定する
v3_tie_pairs = [[-30, 120], [30, 120], [-15, 205], [15, 205]];

// v3ポッド(フランジレス): ベイ床からデッキへのM3x8皿x4(ベイ中心基準)
v3pod_floor_screws = [[-12, -38], [12, -38], [-12, 38], [12, 38]];
